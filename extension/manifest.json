{
  "manifest_version": 3,
  "name": "Nemesis Guard",
  "short_name": "Nemesis",
  "version": "1.0.0",
  "description": "Flags phishing pages as you browse, checks links before you click, and inspects anything you paste. Runs locally.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nemesis Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": ["tabs", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
